cabal-version:       3.4
name:                haskell-mcda
version:             0.1.0.0
build-type:          Simple

executable haskell-mcda
  main-is:             Main.hs
  hs-source-dirs:      src
  default-language:    Haskell2010
  ghc-options:         -O2 -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base >=4.14 && <5
    , aeson >=2.0
    , bytestring
    , containers
    , text
    , wai
    , servant
    , servant-server
    , warp
    , transformers
    , mtl
